# oc-conditions config
# Copy this file to .env and fill in your values

# Your phone number for SMS (digits only, no dashes)
YOUR_PHONE_NUMBER=4105550000

# Your carrier SMS gateway (already set for AT&T)
SMS_GATEWAY=txt.att.net

# The Gmail address this script sends FROM
# (must be the same Google account running the script)
GMAIL_ADDRESS=you@gmail.com

# NOAA station for Ocean City Inlet, MD — no need to change
NOAA_STATION=8570283

# NWS grid point for Ocean City, MD — no need to change
NWS_OFFICE=AKQ
NWS_GRID_X=51
NWS_GRID_Y=20

# Port for the local web server
PORT=3000
